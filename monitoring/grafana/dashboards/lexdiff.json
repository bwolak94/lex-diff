{
  "title": "LexDiff",
  "uid": "lexdiff-main",
  "schemaVersion": 38,
  "version": 2,
  "refresh": "30s",
  "time": { "from": "now-3h", "to": "now" },
  "tags": ["lexdiff"],
  "panels": [
    {
      "id": 100,
      "type": "row",
      "title": "Diff Quality",
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 1 },
      "collapsed": false
    },
    {
      "id": 1,
      "type": "timeseries",
      "title": "unmatchedRatio — p50 / p95 / p99",
      "description": "S6-6: Alert fires when p95 exceeds 0.05. A rising p95 signals a parser or matching regression.",
      "gridPos": { "x": 0, "y": 1, "w": 14, "h": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, rate(lexdiff_diff_unmatched_ratio_bucket[10m]))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, rate(lexdiff_diff_unmatched_ratio_bucket[10m]))",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, rate(lexdiff_diff_unmatched_ratio_bucket[10m]))",
          "legendFormat": "p99"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 0.3,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "green" },
              { "value": 0.05, "color": "orange" },
              { "value": 0.1,  "color": "red" }
            ]
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "thresholdsStyle": { "mode": "line+area" }
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "p95" },
            "properties": [{ "id": "color", "value": { "fixedColor": "orange", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byName", "options": "p99" },
            "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }]
          }
        ]
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Diff runs / s",
      "gridPos": { "x": 14, "y": 1, "w": 5, "h": 4 },
      "targets": [
        {
          "expr": "rate(lexdiff_diff_unmatched_ratio_count[5m])",
          "legendFormat": "runs/s"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ops", "decimals": 2 } },
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Change events (total)",
      "gridPos": { "x": 19, "y": 1, "w": 5, "h": 4 },
      "targets": [
        {
          "expr": "sum(lexdiff_change_events_generated_total)",
          "legendFormat": "total"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0 } },
      "options": { "colorMode": "value", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "p95 unmatchedRatio (10m)",
      "description": "Alert threshold: 5 %",
      "gridPos": { "x": 14, "y": 5, "w": 5, "h": 4 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, rate(lexdiff_diff_unmatched_ratio_bucket[10m]))",
          "legendFormat": "p95"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 3,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "green" },
              { "value": 0.05, "color": "orange" },
              { "value": 0.1,  "color": "red" }
            ]
          }
        }
      },
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Syncs / hour",
      "gridPos": { "x": 19, "y": 5, "w": 5, "h": 4 },
      "targets": [
        {
          "expr": "increase(lexdiff_sync_duration_seconds_count{result=\"synced\"}[1h])",
          "legendFormat": "synced"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0 } },
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },

    {
      "id": 200,
      "type": "row",
      "title": "HTTP Performance",
      "gridPos": { "x": 0, "y": 9, "w": 24, "h": 1 },
      "collapsed": false
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "HTTP request latency — p50 / p95 / p99",
      "gridPos": { "x": 0, "y": 10, "w": 14, "h": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, rate(http_request_duration_seconds_bucket[5m]))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, rate(http_request_duration_seconds_bucket[5m]))",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, rate(http_request_duration_seconds_bucket[5m]))",
          "legendFormat": "p99"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "green" },
              { "value": 0.5,  "color": "orange" },
              { "value": 1,    "color": "red" }
            ]
          },
          "custom": { "lineWidth": 2, "fillOpacity": 10, "showPoints": "never" }
        }
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      }
    },
    {
      "id": 11,
      "type": "stat",
      "title": "Request rate (req/s)",
      "gridPos": { "x": 14, "y": 10, "w": 5, "h": 4 },
      "targets": [
        {
          "expr": "rate(http_request_duration_seconds_count[5m])",
          "legendFormat": "req/s"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps", "decimals": 2 } },
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 12,
      "type": "stat",
      "title": "5xx error rate",
      "gridPos": { "x": 19, "y": 10, "w": 5, "h": 4 },
      "targets": [
        {
          "expr": "rate(http_request_duration_seconds_count{status_code=~\"5..\"}[5m])",
          "legendFormat": "5xx/s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 3,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null,  "color": "green" },
              { "value": 0.001, "color": "orange" },
              { "value": 0.01,  "color": "red" }
            ]
          }
        }
      },
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Request rate by route (top 10)",
      "gridPos": { "x": 14, "y": 14, "w": 10, "h": 4 },
      "targets": [
        {
          "expr": "topk(10, rate(http_request_duration_seconds_count[5m])) by (route)",
          "legendFormat": "{{route}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "lineWidth": 1, "showPoints": "never" } } },
      "options": { "legend": { "displayMode": "list", "placement": "right" } }
    },

    {
      "id": 300,
      "type": "row",
      "title": "Sync Performance",
      "gridPos": { "x": 0, "y": 18, "w": 24, "h": 1 },
      "collapsed": false
    },
    {
      "id": 20,
      "type": "timeseries",
      "title": "Sync duration — p50 / p95",
      "gridPos": { "x": 0, "y": 19, "w": 14, "h": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, rate(lexdiff_sync_duration_seconds_bucket{result=\"synced\"}[10m]))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, rate(lexdiff_sync_duration_seconds_bucket{result=\"synced\"}[10m]))",
          "legendFormat": "p95"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "lineWidth": 2, "fillOpacity": 10, "showPoints": "never" }
        }
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      }
    },
    {
      "id": 21,
      "type": "stat",
      "title": "p95 sync duration",
      "gridPos": { "x": 14, "y": 19, "w": 5, "h": 4 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, rate(lexdiff_sync_duration_seconds_bucket{result=\"synced\"}[10m]))",
          "legendFormat": "p95"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "green" },
              { "value": 10,   "color": "orange" },
              { "value": 30,   "color": "red" }
            ]
          }
        }
      },
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 22,
      "type": "stat",
      "title": "Skipped (unchanged) / hour",
      "gridPos": { "x": 19, "y": 19, "w": 5, "h": 4 },
      "targets": [
        {
          "expr": "increase(lexdiff_sync_duration_seconds_count{result=\"skipped\"}[1h])",
          "legendFormat": "skipped"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0 } },
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 23,
      "type": "timeseries",
      "title": "Change events generated per hour",
      "gridPos": { "x": 14, "y": 23, "w": 10, "h": 4 },
      "targets": [
        {
          "expr": "increase(lexdiff_change_events_generated_total[1h])",
          "legendFormat": "events"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "lineWidth": 1, "fillOpacity": 10, "showPoints": "never" } } }
    },

    {
      "id": 400,
      "type": "row",
      "title": "Infrastructure",
      "gridPos": { "x": 0, "y": 27, "w": 24, "h": 1 },
      "collapsed": false
    },
    {
      "id": 30,
      "type": "timeseries",
      "title": "Node.js heap used",
      "gridPos": { "x": 0, "y": 28, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "nodejs_heap_size_used_bytes",
          "legendFormat": "heap used"
        },
        {
          "expr": "nodejs_heap_size_total_bytes",
          "legendFormat": "heap total"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": { "lineWidth": 2, "fillOpacity": 10, "showPoints": "never" }
        }
      }
    },
    {
      "id": 31,
      "type": "timeseries",
      "title": "Node.js event loop lag",
      "gridPos": { "x": 12, "y": 28, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "nodejs_eventloop_lag_seconds",
          "legendFormat": "lag"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "green" },
              { "value": 0.1,  "color": "orange" },
              { "value": 0.5,  "color": "red" }
            ]
          },
          "custom": { "lineWidth": 2, "showPoints": "never" }
        }
      }
    },
    {
      "id": 32,
      "type": "logs",
      "title": "API logs (Loki)",
      "gridPos": { "x": 0, "y": 36, "w": 24, "h": 10 },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "{job=\"lexdiff-api\"}",
          "legendFormat": ""
        }
      ],
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showTime": true,
        "wrapLogMessage": false
      }
    }
  ]
}
