{
  "name": "@lexdiff/core",
  "version": "0.1.0",
  "description": "Parser, diff engine, and domain types for LexDiff",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "diff-match-patch": "^1.0.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/diff-match-patch": "^1.0.36",
    "@types/node": "^22.10.5",
    "fast-check": "^3.23.2",
    "msw": "^2.7.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
