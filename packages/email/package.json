    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@react-email/components": "^0.0.31",
    "@react-email/render": "^0.0.12",
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.2",
    "react-email": "^3.0.6",
    "typescript": "^5.7.2"
  }
}
